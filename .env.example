# Database (Supabase Postgres)
# Get this from your Supabase project: Settings -> Database -> Connection
# string -> URI (use the "Direct connection", not the pooled one, since
# `prisma db push` and migrations need it).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Session / auth
# Generate a strong random value, e.g.: openssl rand -base64 48
SESSION_SECRET="replace-this-with-a-long-random-string-in-production"

# App
NODE_ENV="development"

# File storage (local disk for the prototype)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"
