# Database
# Prototype default: local SQLite file, zero setup required.
DATABASE_URL="file:./dev.db"
# Production example (see README "Switching to PostgreSQL"):
# DATABASE_URL="postgresql://orms_user:password@localhost:5432/orms?schema=public"

# Session / auth
# Generate a strong random value, e.g.: openssl rand -base64 48
SESSION_SECRET="replace-this-with-a-long-random-string-in-production"

# App
NODE_ENV="development"

# File storage (local disk for the prototype)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"
